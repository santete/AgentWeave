# ═══════════════════════════════════════════════════════════════
# AgentWeave — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env
#   # Edit .env with your keys
#
# Then load before running:
#   source .env    (Linux/Mac)
#   set -a && source .env && set +a    (if export needed)
#
# Or use the credential store (recommended — encrypted at rest):
#   agentweave credentials set claude ANTHROPIC_API_KEY
# ═══════════════════════════════════════════════════════════════

# ─── Claude Code ──────────────────────────────────────────────
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── OpenRouter (works with any model — free models available) ─
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── OpenAI (for Codex CLI, GPT models) ──────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── Google (for Gemini models) ───────────────────────────────
# Get key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── AgentWeave Credential Encryption ─────────────────────────
# Optional: passphrase for encrypting credential store
# If set, credentials use PBKDF2 (strong encryption)
# If not set, machine-derived key used (obfuscation only)
AGENTWEAVE_CREDENTIAL_KEY=

# ─── OpenRouter Model Override ────────────────────────────────
# Default model when using OpenRouter
# Free models: nvidia/nemotron-nano-9b-v2:free, deepseek/deepseek-r1-0528:free
OPENROUTER_MODEL=
