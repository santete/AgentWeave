{
  "_comment": "Merge these entries into .claude/settings.json -> hooks to activate AgentWeave governance. Remove any existing PreToolUse/PostToolUse entries for the same matchers first, or Claude Code will run both.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.claude/hooks/pre-tool-use.cjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ./.claude/hooks/post-tool-use.cjs"
          }
        ]
      }
    ]
  }
}
