{
	"name": "@agentweave/types",
	"version": "0.1.0",
	"type": "module",
	"description": "Shared type contracts for AgentWeave Inner/Outer Harness",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/santete/AgentWeave.git",
		"directory": "packages/types"
	},
	"homepage": "https://github.com/santete/AgentWeave",
	"keywords": [
		"agentweave",
		"ai-agent",
		"governance",
		"harness",
		"types",
		"typescript",
		"contracts"
	],
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --format esm --dts --clean",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"test:unit": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"typescript": "^5.7.0",
		"tsup": "^8.3.0",
		"vitest": "^2.1.0"
	}
}
