{
  "name": "@agentweave/outer-harness",
  "version": "0.1.0",
  "type": "module",
  "description": "Outer Harness — Governance layer for AgentWeave (permissions, output pipeline, budget)",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/santete/AgentWeave.git",
    "directory": "packages/outer-harness"
  },
  "homepage": "https://github.com/santete/AgentWeave",
  "keywords": [
    "agentweave",
    "ai-agent",
    "governance",
    "harness",
    "outer-harness",
    "permissions",
    "budget",
    "output-pipeline"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentweave/types": "workspace:*",
    "@agentweave/control-plane": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
