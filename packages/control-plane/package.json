{
  "name": "@agentweave/control-plane",
  "version": "0.1.0",
  "type": "module",
  "description": "Control Plane — Event Bus, Command Bus, and Interceptor Registry for AgentWeave",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/santete/AgentWeave.git",
    "directory": "packages/control-plane"
  },
  "homepage": "https://github.com/santete/AgentWeave",
  "keywords": [
    "agentweave",
    "ai-agent",
    "governance",
    "harness",
    "control-plane",
    "event-bus",
    "command-bus",
    "interceptor"
  ],
  "publishConfig": {
