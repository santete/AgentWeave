{
  "name": "@agentweave/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "AgentWeave CLI — Run governed AI agents from the terminal",
  "bin": {
    "agentweave": "./dist/bin.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/santete/AgentWeave.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/santete/AgentWeave",
  "keywords": [
    "agentweave",
    "ai-agent",
    "governance",
    "harness",
    "cli",
    "terminal",
    "command-line"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/bin.ts --format esm --clean",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentweave/sdk": "workspace:*",
    "@agentweave/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
