{
  "name": "@agentweave/gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "AgentWeave Gateway — AWOCP WebSocket server with shared governance",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/santete/AgentWeave.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/santete/AgentWeave",
  "keywords": [
    "agentweave",
    "ai-agent",
    "governance",
    "harness",
    "gateway",
    "websocket-server",
    "awocp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentweave/types": "workspace:*",
    "@agentweave/protocol": "workspace:*",
    "@agentweave/outer-harness": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
